# Copy to .env (or run scripts/detect-zscaler-cert.sh to generate it).

# Host port the simulator is reachable on.
PORT=8787

# Path to this machine's Zscaler root CA, if Zscaler Client Connector is
# running here. docker-compose bind-mounts it into the running container
# for the app's own HTTPS calls. Leave the default (empty placeholder)
# on machines without ZCC.
# Build-time trust is separate: scripts/detect-zscaler-cert.sh writes
# docker/zscaler-ca.crt (gitignored) and the image does not keep that file.
ZSCALER_CERT_PATH=./docker/empty-ca.crt
