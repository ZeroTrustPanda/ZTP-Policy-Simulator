{
  "name": "ztp-policy-simulator",
  "version": "1.5.0",
  "description": "ZeroTrustPanda ZS Policy Simulator \u2014 standalone Zscaler policy simulator (ZIA, ZPA, Client Connector)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/engine.test.js test/bulk.test.js test/changes.test.js",
    "build": "pkg . --targets node20-win-x64,node20-macos-arm64,node20-macos-x64 --no-bytecode --public --public-packages \"*\" --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  }
}
